# 예시 파일입니다. 실제 값은 .env(로컬) 또는 Railway Variables(배포)에 넣으세요.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxx

# 공공데이터포털 인증키 (비워 두면 연습 모드)
DATA_GO_KR_KEY=

# /collect 보호용 암호 (아무 긴 문자열)
ADMIN_TOKEN=change-me-long-random-string

# 이 API를 불러도 되는 프론트 주소. 쉼표 구분, 끝에 / 없이
#   로컬:    http://127.0.0.1:5000,http://localhost:5000
#   Railway: https://day3-frontend.vercel.app
FRONT_ORIGINS=http://127.0.0.1:5000,http://localhost:5000

SIDO_NAME=제주
COLLECT_MINUTES=60
